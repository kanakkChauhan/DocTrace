# Base URL of the DocTrace backend API, with no trailing slash and no
# "/api/v1" suffix (that's appended automatically). Leave unset for local
# development -- requests then go to a relative "/api/v1" path, which the
# Vite dev server proxies to the backend (see vite.config.ts).
#
# Set this explicitly for any deployment where the frontend and backend are
# not served from the same origin, e.g.:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=